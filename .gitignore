# Godot 4+ specific ignores
.godot/
/android/

# Godot mono / C# (not currently used, kept for safety)
.mono/
data_*/
mono_crash.*.json

# Exported build artifacts
builds/
export/

# Local tooling state
.swarm/
.opencode/

# OS cruft
.DS_Store
Thumbs.db

# Editor backups
*.tmp
*.bak
*~

# LPC factory generated outputs (sources, definitions, palettes, credits stay tracked)

tools/lpc-factory/upstream/

tools/lpc-factory/build/

tools/lpc-factory/node_modules/

# Machine-local config (Aseprite path differs per machine)
tools/lpc-factory/config/local.json

# Audio pipeline local state (sources, processed files, licenses stay tracked)
tools/audio-pipeline/node_modules/
tools/audio-pipeline/.cache/

# Game-ready re-encodes are derived: rebuild with `npm run audio:normalize`
# inside tools/audio-pipeline (production copies live in tracked audio/).
tools/audio-pipeline/processed/
